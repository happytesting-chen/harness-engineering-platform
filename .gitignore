# Exclude everything by default
*

# Include platform content
!.gitignore
!LICENSE
!assets/
!assets/*.svg
!template/
!template/**
!examples/
!examples/**
!.kiro/
!.kiro/specs/
!.kiro/specs/harness-engineering-platform/
!.kiro/specs/harness-engineering-platform/**

# CI. Required explicitly: line 2's `*` would otherwise ignore .github/ entirely, so a
# workflow file could be written, committed with `git add -A`, and never run — the same
# silent-skip class as spec §6.2 item 12.
!.github/
!.github/**

# Exclude generated artifacts within included dirs
__pycache__/
*.pyc
.pytest_cache/
*.log
.DS_Store

# Tool caches inside force-included trees
**/.pytest_cache/
**/__pycache__/

# Operator-local working material (decks, scratch). Kept on disk, never shipped.
_local/
