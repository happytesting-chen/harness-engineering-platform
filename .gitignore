# Exclude everything by default
*

# Include platform content
!.gitignore
!LICENSE
!assets/
!assets/*.svg
!template/
!template/**
!examples/
!examples/**
!.kiro/
!.kiro/specs/
!.kiro/specs/harness-engineering-platform/
!.kiro/specs/harness-engineering-platform/**

# Exclude generated artifacts within included dirs
__pycache__/
*.pyc
.pytest_cache/
*.log
.DS_Store
